{
  "mcpServers": {
    "zcode-ops": {
      "command": "D:\\Program Files\\nodejs\\node.exe",
      "args": ["./scripts/mcp-gateway.mjs"],
      "cwd": ".",
      "enabled": true,
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 120,
      "default_tools_approval_mode": "prompt",
      "tools": {

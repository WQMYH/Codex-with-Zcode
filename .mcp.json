        "zcode_remote_tasks": { "approval_mode": "auto" },
        "zcode_remote_read": { "approval_mode": "auto" },
        "zcode_remote_send": { "approval_mode": "prompt" },
        "zcode_list_sessions": { "approval_mode": "auto" },
        "zcode_prompt_events": { "approval_mode": "auto" },
        "zcode_task_poll": { "approval_mode": "auto" },
        "zcode_desktop_sessions_status": { "approval_mode": "auto" },
        "zcode_bridge_session_status": { "approval_mode": "auto" },
        "zcode_runtime_status": { "approval_mode": "auto" }

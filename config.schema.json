{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WQMYH/Codex-with-Zcode/main/config.schema.json",
  "title": "ZCode Ops configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sharingLink"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "promptOnStartup": { "const": false, "deprecated": true },
    "sharingLink": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
